{
  "name": "ranch-spotify",
  "productName": "Ranch Spotify",
  "version": "1.0.0",
  "description": "Spotify for Windows, Android and iPhone without ads or upsells, with a sleep timer, song notifications and taskbar controls",
  "main": "src/main.js",
  "author": "KingCreeper531",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "repository": "https://github.com/KingCreeper531/spotify-desktop",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.ranch.spotify",
    "productName": "Ranch Spotify",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/badge.png",
      "package.json",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KingCreeper531",
        "repo": "spotify-desktop",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Ranch-Spotify-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ranch Spotify",
      "runAfterFinish": true
    },
    "electronVersion": "45.2.1+wvcus",
    "electronDist": "node_modules/electron/dist"
  }
}
